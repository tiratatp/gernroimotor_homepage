# index.html, robots.txt, sitemap.xml are GENERATED by build.py — never edit directly
# ไฟล์เหล่านี้ถูกสร้างอัตโนมัติ — อย่าแก้ไขโดยตรง ให้แก้ template.html หรือ variables.txt
index.html
robots.txt
sitemap.xml
.omo/
.playwright-mcp/

# WebP copies are generated by .github/optimize.mjs at deploy time only
# ไฟล์ .webp ถูกสร้างอัตโนมัติตอนเผยแพร่เว็บ — ไม่ต้อง commit
images/*.webp

# Python bytecode cache from running tests
__pycache__/

